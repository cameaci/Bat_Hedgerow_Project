{
  "framework_name": "bats_screening_v1",
  "version": "1.0.0",
  "compatible_feature_profile_name": "bats_v1",
  "notes": "Strict GIS-only predictor registry aligned to bats_v1-style enriched outputs. Survey/field labels and status columns are excluded from predictors and used only for confidence/applicability checks.",
  "strict_gis_prefixes": [
    "geom_",
    "net_",
    "dist_",
    "buf",
    "pt_",
    "roostpx_",
    "mhb_"
  ],
  "forbidden_exact": [
    "geom_centroid_x",
    "geom_centroid_y",
    "net_component_id"
  ],
  "forbidden_prefixes": [],
  "forbidden_regex": [
    ".*_status$"
  ],
  "status_columns": [
    "deploy_parse_status",
    "deploy_status",
    "depwx_status",
    "moon_status",
    "roostpx_status",
    "mhb_status"
  ],
  "status_regex": [
    ".*_status$"
  ],
  "coverage_flags": [
    "phi_coverage_flag",
    "awi_coverage_flag"
  ],
  "alias_map": {},
  "required_predictors": [
    "geom_length_m",
    "geom_sinuosity",
    "net_degree_max"
  ],
  "predictor_order": [
