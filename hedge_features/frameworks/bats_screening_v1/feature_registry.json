    "dist_awi_ancwood_m",
    "buf100_os_road_density_m_per_ha",
    "buf250_os_road_density_m_per_ha",
    "buf500_os_road_density_m_per_ha",
    "buf100_os_river_density_m_per_ha",
    "buf250_os_river_density_m_per_ha",
    "buf500_os_river_density_m_per_ha",
    "buf100_worldcover_tree_pct",
